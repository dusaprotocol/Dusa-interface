# Loaded by Vitest (mode "test") on top of .env: public buildnet endpoints so the unit
# tests can import modules that query the chain. No secrets here.
VITE_CHAIN_ID=0
VITE_NETWORK_NAME=buildnet
VITE_CHAIN_URL=https://buildnet.massa.net/api/v2
VITE_GRPC_URL=https://buildnet.massa.net
VITE_API=http://localhost:3001/trpc
VITE_DATASTORE_API=http://localhost:3001
